{
  "expo": {
    "name": "Notes App",
    "slug": "notes-app",
    "scheme": "notes-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.arvincatalbas09.notesapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#F8FAFC"
      },
      "package": "com.arvincatalbas09.notesapp"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F8FAFC"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a7a470fe-342e-498f-a612-abd47b376cb7"
      }
    }
  }
}
